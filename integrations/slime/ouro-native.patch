diff --git a/slime_plugins/ouro_training.py b/slime_plugins/ouro_training.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c55dd4f038e45aaa679df6d04e3b0f2d68123a5
--- /dev/null
+++ b/slime_plugins/ouro_training.py
@@ -0,0 +1,202 @@
+"""Single-update Ouro optimizations with an independent replay audit.
+
+The detached training forward is the old policy only while no optimizer step
+has occurred. One complete microbatch per executed depth is independently
+replayed, with the same packing shape. All samples retain TIS/finite checks.
+"""
+import json
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+
+_state = None
+
+
+def homogeneous_schedule(metadata, lengths, micro_batch_size):
+    if micro_batch_size < 1 or len(metadata) != len(lengths):
+        raise ValueError("Invalid Ouro microbatch schedule")
+    groups = {}
+    for i, item in enumerate(metadata):
+        depth = item["ouro_depth"]
+        if type(depth) is not int or depth not in (2, 3, 4):
+            raise ValueError("Invalid Ouro depth")
+        groups.setdefault(depth, []).append(i)
+    batches = []
+    for depth in sorted(groups):
+        indices = sorted(groups[depth], key=lambda i: (lengths[i], i))
+        batches.extend(indices[i:i + micro_batch_size]
+                       for i in range(0, len(indices), micro_batch_size))
+    return batches
+
+
+def configure_microbatches(args, data):
+    if not getattr(args, "ouro_group_microbatches", False):
+        return
+    if len(data["global_batch_sizes"]) != 1 or args.num_steps_per_rollout != 1:
+        raise ValueError("Ouro grouped batches require one optimizer update")
+    schedule = homogeneous_schedule(data["metadata"], data["total_lengths"], args.micro_batch_size)
+    # TP=PP=CP=1: unequal microbatch counts across DP ranks are safe when
+    # gradient synchronization happens only at the end of accumulation.
+    if getattr(args, "overlap_grad_reduce", False):
+        raise ValueError("Ouro grouped batches require overlap_grad_reduce=False")
+    data["micro_batch_indices"] = schedule
+    data["num_microbatches"] = [len(schedule)]
+
+
+def validate_reuse_config(args, data):
+    if (args.num_steps_per_rollout != 1 or len(data["num_microbatches"]) != 1
+            or args.use_rollout_logprobs or args.kl_coef != 0
+            or args.loss_type != "custom_loss"
+            or args.custom_loss_function_path != ("looprl.native_2b.policy_loss" if getattr(args, "ouro_token_exit", False) else "looprl.native_2a.policy_loss")
+            or args.advantage_estimator != "grpo"
+            or getattr(args, "ouro_learned_depth", False)
+            or getattr(args, "recompute_loss_function", False)
+            or getattr(args, "use_critic", False) or getattr(args, "use_opd", False)
+            or getattr(args, "use_routing_replay", False)
+            or getattr(args, "attention_dropout", 0) != 0
+            or getattr(args, "hidden_dropout", 0) != 0
+            or not getattr(args, "use_tis", False)
+            or getattr(args, "ouro_rollout_correction", None) != "tis"):
+        raise ValueError("Ouro probability reuse requires one deterministic GRPO/TIS update")
+
+
+def begin_audit(args, data, audits, gate_audits=None):
+    global _state
+    validate_reuse_config(args, data)
+    expected = dict(zip(data["partition"], data["response_lengths"], strict=True))
+    if len(expected) != len(data["partition"]) or not audits or not set(audits) <= expected.keys():
+        raise ValueError("Invalid or missing independent Ouro replay audit")
+    if getattr(args, "ouro_token_exit", False) and (not gate_audits or gate_audits.keys() != audits.keys()):
+        raise ValueError("Token-exit policy requires separate gate replay audits")
+    steps = {m["ouro_step"] for m in data["metadata"]}
+    if len(steps) != 1:
+        raise ValueError("Mixed Ouro update IDs")
+    for key in ("ref_log_probs", "rollout_log_probs"):
+        if len(data[key]) != len(expected) or any(
+                t.numel() != n or not torch.isfinite(t).all()
+                for t, n in zip(data[key], data["response_lengths"], strict=True)):
+            raise ValueError("Invalid Ouro reference or sampling probabilities")
+    _state = dict(step=steps.pop(), expected=expected, audits=audits, seen=set(),
+                  sums=None, maxima=None, audited=0, gate_audits=gate_audits)
+
+
+def prepare_reuse(actor, data, iterators):
+    """Replay a representative full microbatch at each locally present depth."""
+    from slime.backends.megatron_utils.data import DataIterator
+    validate_reuse_config(actor.args, data)
+    by_depth = {}
+    for batch in iterators[0].micro_batch_indices:
+        depths = {data["metadata"][i]["ouro_depth"] for i in batch}
+        if len(depths) != 1:
+            raise ValueError("Mixed depths in an Ouro microbatch")
+        depth = depths.pop()
+        if depth not in by_depth or sum(data["total_lengths"][i] for i in batch) > sum(
+                data["total_lengths"][i] for i in by_depth[depth]):
+            by_depth[depth] = batch
+    selected = list(by_depth.values())
+    indices = [i for batch in selected for i in batch]
+    subset = {key: [value[i] for i in indices] for key, value in data.items()
+              if isinstance(value, list) and len(value) == len(data["tokens"])}
+    schedule, offset = [], 0
+    for batch in selected:
+        schedule.append(list(range(offset, offset + len(batch))))
+        offset += len(batch)
+    computed = actor.compute_log_prob([DataIterator(subset, schedule)], [len(schedule)], store_prefix="audit_")
+    values = computed["audit_log_probs"]
+    audits = {data["partition"][i]: value.detach() for i, value in zip(indices, values, strict=True)}
+    gate_audits = ({data["partition"][i]: value.detach() for i, value in
+                   zip(indices, computed["audit_exit_log_probs"], strict=True)}
+                  if getattr(actor.args, "ouro_token_exit", False) else None)
+    begin_audit(actor.args, data, audits, gate_audits)
+
+
+def record_reuse(args, batch, current, gate_current=None):
+    """Collect additive full-batch diagnostics, including an exact coverage check."""
+    if _state is None:
+        raise ValueError("Ouro reuse audit was not initialized")
+    positions = batch["partition"]
+    if len(positions) != len(batch["response_lengths"]):
+        raise ValueError("Ouro audit sample count mismatch")
+    values = current.detach().split(batch["response_lengths"])
+    gated = getattr(args, "ouro_token_exit", False)
+    if gated and (gate_current is None or not torch.isfinite(gate_current).all()):
+        raise ValueError("Missing or nonfinite current gate probabilities")
+    gate_values = gate_current.detach().split(batch["response_lengths"]) if gated else [None]*len(values)
+    for position, value, gate in zip(positions, values, gate_values, strict=True):
+        if (position not in _state["expected"] or position in _state["seen"]
+                or value.numel() != _state["expected"][position]):
+            raise ValueError("Duplicate or malformed Ouro training sample")
+        _state["seen"].add(position)
+        if position in _state["audits"]:
+            error = (value - _state["audits"][position]).abs().max()
+            if not torch.isfinite(error) or error > 1e-3:
+                raise ValueError(f"Ouro independent grad/no-grad replay mismatch: {float(error)}")
+            _state["audited"] += 1
+        else:
+            error = value.new_zeros(())
+        _state["maxima"] = error.reshape(1) if _state["maxima"] is None else torch.maximum(_state["maxima"], error)
+        if gated and position in _state["gate_audits"]:
+            gate_error = (gate - _state["gate_audits"][position]).abs().max()
+            if not torch.isfinite(gate_error) or gate_error > 1e-3:
+                raise ValueError("Ouro independent gate grad/no-grad replay mismatch")
+            _state["gate_audit_max"] = torch.maximum(_state.get("gate_audit_max", gate_error.new_zeros(())), gate_error)
+    if gated:
+        sampled_gate = torch.tensor([v for m in batch["metadata"] for v in m["ouro_gate_log_probs"]],device=current.device)
+        if sampled_gate.shape != gate_current.shape or not torch.isfinite(sampled_gate).all():
+            raise ValueError("Invalid sampled gate probabilities")
+        error = (gate_current.detach()-sampled_gate).abs().max()
+        _state["gate_sampler_max"] = torch.maximum(_state.get("gate_sampler_max", error.new_zeros(())),error)
+    sampled = torch.cat(batch["rollout_log_probs"]).to(current.device).detach()
+    delta = current.detach().float() - sampled.float()
+    ratio = delta.exp()
+    if not torch.isfinite(delta).all() or not torch.isfinite(ratio).all():
+        raise ValueError("Nonfinite Ouro reused probabilities")
+    weights = ratio.clamp(max=args.tis_clip)
+    stats = torch.stack([weights.new_tensor(weights.numel()), weights.sum(), weights.square().sum(),
+                         (ratio > args.tis_clip).sum(), delta.abs().sum(),
+                         (delta.expm1() - delta).sum()]).double()
+    _state["sums"] = stats if _state["sums"] is None else _state["sums"] + stats
+    maximum = delta.abs().max()
+    _state["sampler_max"] = maximum if "sampler_max" not in _state else torch.maximum(_state["sampler_max"], maximum)
+
+
+def finish_reuse_audit(args):
+    """Run before optimizer.step; never accept incomplete or unaudited batches."""
+    global _state
+    if (_state is None or _state["seen"] != _state["expected"].keys()
+            or _state["audited"] != len(_state["audits"])):
+        raise ValueError("Incomplete Ouro probability audit before optimizer update")
+    sums = _state["sums"]
+    maxima = torch.cat([_state["maxima"], _state["sampler_max"].reshape(1)])
+    gated = getattr(args, "ouro_token_exit", False)
+    if gated:
+        maxima = torch.cat([maxima, _state["gate_audit_max"].reshape(1), _state["gate_sampler_max"].reshape(1)])
+    counts = sums.new_tensor([len(_state["seen"]), _state["audited"]])
+    rank, world = 0, 1
+    if dist.is_initialized():
+        from megatron.core import mpu
+        group = mpu.get_data_parallel_group()
+        rank, world = mpu.get_data_parallel_rank(), mpu.get_data_parallel_world_size()
+        dist.all_reduce(sums, group=group)
+        dist.all_reduce(counts, group=group)
+        dist.all_reduce(maxima, op=dist.ReduceOp.MAX, group=group)
+    tokens, weight_sum, square_sum, clipped, abs_sum, k3_sum = sums.tolist()
+    if weight_sum <= 0 or not torch.isfinite(sums).all():
+        raise ValueError("Invalid aggregate Ouro probability diagnostics")
+    report = dict(step=_state["step"], correction="tis", reference_finite=True,
+        tokens=int(tokens), samples=int(counts[0]), audit_samples=int(counts[1]),
+        data_parallel_size=world, old_policy_source="detached_training_forward",
+        grad_no_grad_max_error=float(maxima[0]), sampler_recompute_max_error=float(maxima[1]),
+        tis_weight_mean=weight_sum/tokens, tis_clip_fraction=clipped/tokens,
+        tis_ess_fraction=weight_sum**2/(tokens*square_sum),
+        mismatch_mean_abs=abs_sum/tokens, mismatch_k3=k3_sum/tokens)
+    if gated:
+        report.update(policy_space="joint_exit_token", gate_grad_no_grad_max_error=float(maxima[2]),
+                      gate_sampler_recompute_max_error=float(maxima[3]))
+    if rank == 0:
+        path = Path(args.ouro_output)/"consistency.jsonl"
+        with path.open("a") as stream:
+            stream.write(json.dumps(report, allow_nan=False)+"\n")
+    _state = None
+    return report
