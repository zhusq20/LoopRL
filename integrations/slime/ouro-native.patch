diff --git a/slime_plugins/sglang_models/ouro.py b/slime_plugins/sglang_models/ouro.py
new file mode 100644
index 0000000000000000000000000000000000000000..7adf32a13af04f8019dc25c658244b90d924fc35
--- /dev/null
+++ b/slime_plugins/sglang_models/ouro.py
@@ -0,0 +1,196 @@
+"""Fixed sequence-depth Ouro serving with shared weights and per-loop KV slots.
+
+Set SGLANG_EXTERNAL_MODEL_PACKAGE=slime_plugins.sglang_models and select the
+depth with --json-model-override-args '{"total_ut_steps": 2}'. A serving engine
+has one depth; changing depth for a live KV cache is intentionally unsupported.
+"""
+
+import torch
+from torch import nn
+
+from sglang.srt.layers.linear import QKVParallelLinear, RowParallelLinear
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.layers.rotary_embedding import get_rope
+from sglang.srt.layers.vocab_parallel_embedding import VocabParallelEmbedding
+from sglang.srt.model_loader.weight_utils import default_weight_loader
+from sglang.srt.models.llama import LlamaForCausalLM, LlamaMLP
+from sglang.srt.utils import add_prefix
+from sglang.srt.runtime_context import get_parallel
+from slime_plugins.ouro_attention import install as install_ouro_attention
+
+install_ouro_attention()
+
+
+class OuroRMSNorm(nn.Module):
+    def __init__(self, hidden_size, eps, fused=False):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size))
+        self.eps = eps
+        self.fused = fused
+
+    def forward(self, hidden):
+        if self.fused:
+            if hidden.dtype == torch.bfloat16:
+                from sgl_kernel import rmsnorm
+                return rmsnorm(hidden, self.weight, self.eps)
+            from slime_plugins.ouro_kernels import rms_norm
+            return rms_norm(hidden, self.weight, self.eps)
+        value = hidden.float()
+        value = value * torch.rsqrt(value.square().mean(-1, keepdim=True) + self.eps)
+        return self.weight * value.to(hidden.dtype)
+
+
+class OuroAttention(nn.Module):
+    def __init__(self, config, layer_id, prefix):
+        super().__init__()
+        self.num_heads = config.num_attention_heads
+        self.num_kv_heads = config.num_key_value_heads
+        self.head_dim = getattr(config, "head_dim", config.hidden_size // self.num_heads)
+        self.fused = getattr(config, "ouro_fused_ops", False)
+        self.q_size = self.num_heads * self.head_dim
+        self.kv_size = self.num_kv_heads * self.head_dim
+        self.qkv_proj = QKVParallelLinear(config.hidden_size, self.head_dim,
+            self.num_heads, self.num_kv_heads, bias=False, prefix=add_prefix("qkv_proj", prefix))
+        self.o_proj = RowParallelLinear(self.q_size, config.hidden_size,
+            bias=False, prefix=add_prefix("o_proj", prefix))
+        self.rotary_emb = get_rope(self.head_dim, rotary_dim=self.head_dim,
+            max_position=config.max_position_embeddings, base=config.rope_theta,
+            rope_scaling=getattr(config, "rope_scaling", None), is_neox_style=True)
+        self.attn = nn.ModuleList([
+            RadixAttention(self.num_heads, self.head_dim, self.head_dim ** -0.5,
+                num_kv_heads=self.num_kv_heads,
+                layer_id=loop * config.num_hidden_layers + layer_id,
+                prefix=add_prefix(f"attn.{loop}", prefix))
+            for loop in range(config.total_ut_steps)
+        ])
+
+    def forward(self, positions, hidden, forward_batch, loop):
+        qkv, _ = self.qkv_proj(hidden)
+        q, k, v = qkv.split([self.q_size, self.kv_size, self.kv_size], dim=-1)
+        # Select the separately validated FP32 or BF16 performance kernels.
+        # BF16's engine mismatch is measured and corrected by the TIS protocol.
+        if self.fused and q.dtype == torch.float32:
+            from slime_plugins.ouro_kernels import rotary
+            q, k = rotary(positions, q, k, self.rotary_emb.cos_sin_cache, self.head_dim)
+        elif self.fused:
+            q, k = self.rotary_emb(positions, q, k)
+        else:
+            q, k = self.rotary_emb.forward_native(positions, q, k)
+        output = self.attn[loop](q, k, v, forward_batch)
+        return self.o_proj(output)[0]
+
+
+class OuroMLP(LlamaMLP):
+    def forward(self, hidden, forward_batch=None):
+        gate_up, _ = self.gate_up_proj(hidden)
+        activated = (self.act_fn(gate_up) if getattr(self,"fused",False) and hidden.dtype==torch.bfloat16
+                     else self.act_fn.forward_native(gate_up))
+        return self.down_proj(activated)[0]
+
+
+class OuroDecoderLayer(nn.Module):
+    def __init__(self, config, layer_id, prefix):
+        super().__init__()
+        self.self_attn = OuroAttention(config, layer_id, add_prefix("self_attn", prefix))
+        self.mlp = OuroMLP(config.hidden_size, config.intermediate_size, config.hidden_act,
+                            prefix=add_prefix("mlp", prefix))
+        self.mlp.fused = getattr(config,"ouro_fused_ops",False)
+        for name in ("input_layernorm", "input_layernorm_2",
+                     "post_attention_layernorm", "post_attention_layernorm_2"):
+            setattr(self, name, OuroRMSNorm(config.hidden_size, config.rms_norm_eps,
+                                         getattr(config, "ouro_fused_ops", False)))
+
+    def forward(self, positions, hidden, forward_batch, loop):
+        branch = self.self_attn(positions, self.input_layernorm(hidden), forward_batch, loop)
+        hidden = hidden + self.input_layernorm_2(branch)
+        branch = self.mlp(self.post_attention_layernorm(hidden))
+        return hidden + self.post_attention_layernorm_2(branch)
+
+
+class OuroModel(nn.Module):
+    def __init__(self, config, quant_config=None, prefix=""):
+        super().__init__()
+        if get_parallel().tp_size != 1 or get_parallel().pp_group.world_size != 1:
+            raise ValueError("Initial Ouro serving supports TP=PP=1")
+        if quant_config is not None:
+            raise ValueError("Ouro numerical acceptance requires unquantized weights")
+        depth = config.total_ut_steps
+        if type(depth) is not int or depth not in range(1, 5):
+            raise ValueError("Ouro total_ut_steps must be an integer in [1, 4]")
+        self.config = config
+        self.start_layer, self.end_layer = 0, config.num_hidden_layers
+        self.embed_tokens = VocabParallelEmbedding(config.vocab_size, config.hidden_size,
+                                                   prefix=add_prefix("embed_tokens", prefix))
+        self.layers = nn.ModuleList([OuroDecoderLayer(config, i, add_prefix(f"layers.{i}", prefix))
+                                     for i in range(config.num_hidden_layers)])
+        self.norm = OuroRMSNorm(config.hidden_size, config.rms_norm_eps,
+                               getattr(config, "ouro_fused_ops", False))
+        self.early_exit_gate = nn.Linear(config.hidden_size, 1)
+        self.early_exit_gate.requires_grad_(False)
+        if getattr(config, "ouro_learned_depth", False):
+            self.sequence_depth_head = nn.Linear(config.hidden_size, 3)
+            with torch.no_grad():
+                self.sequence_depth_head.weight.zero_()
+                self.sequence_depth_head.bias.copy_(torch.tensor([.1, .1, .8]).log())
+
+    def forward(self, input_ids, positions, forward_batch, input_embeds=None, pp_proxy_tensors=None):
+        if pp_proxy_tensors is not None:
+            raise ValueError("Ouro does not support pipeline parallel serving")
+        if getattr(self.config, "ouro_token_exit", False):
+            from .ouro_token_exit import forward
+            return forward(self, input_ids, positions, forward_batch, input_embeds)
+        hidden = self.embed_tokens(input_ids) if input_embeds is None else input_embeds
+        for loop in range(self.config.total_ut_steps):
+            for layer in self.layers:
+                hidden = layer(positions, hidden, forward_batch, loop)
+            hidden = self.norm(hidden)
+        return hidden
+
+
+class OuroForCausalLM(LlamaForCausalLM):
+    def _init_model(self, config, quant_config=None, prefix=""):
+        return OuroModel(config, quant_config, prefix)
+
+    @torch.no_grad()
+    def forward(self, *args, **kwargs):
+        result = super().forward(*args, **kwargs)
+        if getattr(self.model.config, "ouro_token_exit", False) and getattr(result, "hidden_states", None) is not None:
+            result.hidden_states = self.model.ouro_exit_trace
+        # A depth4, one-token request with return_hidden_states='last' returns
+        # the prompt-conditioned action distribution from the synchronized head.
+        if hasattr(self.model, "sequence_depth_head") and getattr(result, "hidden_states", None) is not None:
+            result.hidden_states = self.model.sequence_depth_head(result.hidden_states).log_softmax(-1)
+        return result
+
+    def forward_split_prefill(self, *args, **kwargs):
+        raise ValueError("Split prefill needs recurrent scheduling and is not supported for Ouro")
+
+    def set_eagle3_layers_to_capture(self, *args, **kwargs):
+        raise ValueError("Ouro does not support speculative hidden-state capture")
+
+    set_dflash_layers_to_capture = set_eagle3_layers_to_capture
+
+    def load_weights(self, weights):
+        # The same path handles initial HF loading and slime's partial weight
+        # updates. Unknown names are errors rather than silently skipped tensors.
+        parameters = dict(self.named_parameters())
+        loaded = set()
+        for name, value in weights:
+            if name.endswith("rotary_emb.inv_freq"):
+                continue
+            for target, source, shard in self.stacked_params_mapping:
+                if source in name:
+                    mapped = name.replace(source, target)
+                    parameter = parameters[mapped]
+                    parameter.weight_loader(parameter, value, shard)
+                    loaded.add(mapped)
+                    break
+            else:
+                parameter = parameters[name]
+                loader = getattr(parameter, "weight_loader", default_weight_loader)
+                loader(parameter, value)
+                loaded.add(name)
+        return loaded
+
+
+EntryClass = OuroForCausalLM
diff --git a/slime_plugins/sglang_models/ouro_token_exit.py b/slime_plugins/sglang_models/ouro_token_exit.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a50a36cd13fb86f2a271d0ffe4e4fc1820e21b3
--- /dev/null
+++ b/slime_plugins/sglang_models/ouro_token_exit.py
@@ -0,0 +1,112 @@
+"""Batched physical early exit with last-exited per-layer KV propagation."""
+import copy
+
+import torch
+from torch.nn import functional as F
+from sglang.srt.model_executor.forward_context import get_attn_backend, get_token_to_kv_pool
+
+
+def uniform(seeds, positions, loop):
+    # Stateless, independently salted from token sampling; invariant to batch
+    # packing and request completion order. All arithmetic is modulo 2**32.
+    value = (seeds ^ (positions * 0x9E3779B9) ^ (loop * 0x85EBCA6B) ^ 0xA511E9B3) & 0xFFFFFFFF
+    value = ((value ^ (value >> 16)) * 0x7FEB352D) & 0xFFFFFFFF
+    value = ((value ^ (value >> 15)) * 0x846CA68B) & 0xFFFFFFFF
+    value = value ^ (value >> 16)
+    return (value.double() + .5) / 4294967296.
+
+
+def subset_decode(batch, indices):
+    view = copy.copy(batch)
+    cpu = indices.cpu()
+    view.batch_size = indices.numel()
+    for name in ("input_ids", "positions", "req_pool_indices", "seq_lens", "out_cache_loc"):
+        value = getattr(batch, name)
+        setattr(view, name, value.index_select(0, indices))
+    view.seq_lens_cpu = batch.seq_lens_cpu.index_select(0, cpu)
+    view.seq_lens_sum = int(view.seq_lens_cpu.sum())
+    view.global_num_token_non_padded_cpu = view.batch_size
+    if batch.global_num_token_non_padded is not None:
+        view.global_num_token_non_padded = batch.global_num_token_non_padded.new_tensor(view.batch_size)
+    if batch.num_token_non_padded is not None:
+        view.num_token_non_padded = batch.num_token_non_padded.new_tensor(view.batch_size)
+    return view
+
+
+def propagate_exit_kv(model, batch, indices, loop):
+    if indices.numel() == 0 or loop == 3:
+        return
+    pool = get_token_to_kv_pool()
+    slots = batch.out_cache_loc.index_select(0, indices).long()
+    layers = len(model.layers)
+    for index in range(layers):
+        key = pool.get_key_buffer(loop * layers + index).index_select(0, slots)
+        value = pool.get_value_buffer(loop * layers + index).index_select(0, slots)
+        for later in range(loop + 1, 4):
+            pool.get_key_buffer(later * layers + index).index_copy_(0, slots, key)
+            pool.get_value_buffer(later * layers + index).index_copy_(0, slots, value)
+
+
+def forward(model, input_ids, positions, batch, input_embeds=None):
+    if model.config.total_ut_steps != 4 or batch.forward_mode.is_idle():
+        raise ValueError("Token exit requires four physical loop slots and a nonempty batch")
+    hidden = model.embed_tokens(input_ids) if input_embeds is None else input_embeds
+    seeds = batch.sampling_info.sampling_seed
+    if seeds is None:
+        # Server warmup/health probes may omit a seed. Actual rollout requests
+        # carry ouro_token_exit in custom_params, which preserves their seed.
+        seeds = torch.full((batch.batch_size,), 42, device=hidden.device, dtype=torch.long)
+    if batch.forward_mode.is_decode():
+        selected = torch.empty_like(hidden)
+        logq = torch.zeros(batch.batch_size, device=hidden.device, dtype=torch.float32)
+        exits = torch.zeros(batch.batch_size, device=hidden.device, dtype=torch.long)
+        active = torch.arange(batch.batch_size, device=hidden.device)
+        for loop in range(4):
+            view = batch if active.numel() == batch.batch_size else subset_decode(batch, active)
+            get_attn_backend().init_forward_metadata(view)
+            active_positions = positions.index_select(0, active)
+            for layer in model.layers:
+                hidden = layer(active_positions, hidden, view, loop)
+            hidden = model.norm(hidden)
+            hazard = model.early_exit_gate(hidden).squeeze(-1).float() - model.config.ouro_gate_shift
+            stop = (uniform(seeds[active], active_positions, loop+1) < hazard.sigmoid()) if loop < 3 else torch.ones_like(hazard,dtype=torch.bool)
+            if loop < 3:
+                logq[active] += torch.where(stop, F.logsigmoid(hazard), F.logsigmoid(-hazard))
+            finished = active[stop]
+            selected[finished] = hidden[stop]
+            exits[finished] = loop + 1
+            propagate_exit_kv(model, batch, finished, loop)
+            active = active[~stop]
+            if active.numel() == 0:
+                break
+            hidden = hidden[~stop]
+        model.ouro_exit_trace = torch.stack([exits.float(), logq], dim=-1)
+        return selected
+    if not batch.forward_mode.is_extend() or batch.extend_seq_lens_cpu is None:
+        raise ValueError("Token exit only supports ordinary prefill and decode")
+    if any(batch.extend_prefix_lens_cpu):
+        raise ValueError("Token-exit rollout requires fresh dense prompt prefill, without radix reuse")
+    # Dense prompt KV at all loops, but the first token may use any readout.
+    ends = torch.tensor(batch.extend_seq_lens_cpu,device=hidden.device).cumsum(0)-1
+    selected = torch.empty((batch.batch_size,hidden.shape[-1]),device=hidden.device,dtype=hidden.dtype)
+    active = torch.ones(batch.batch_size,device=hidden.device,dtype=torch.bool)
+    logq = torch.zeros(batch.batch_size,device=hidden.device,dtype=torch.float32)
+    exits = torch.zeros(batch.batch_size,device=hidden.device,dtype=torch.long)
+    for loop in range(4):
+        for layer in model.layers:
+            hidden = layer(positions, hidden, batch, loop)
+        hidden = model.norm(hidden)
+        features = hidden[ends]
+        hazard = model.early_exit_gate(features).squeeze(-1).float() - model.config.ouro_gate_shift
+        stop = (uniform(seeds, positions[ends], loop+1) < hazard.sigmoid()) if loop < 3 else torch.ones_like(active)
+        if loop < 3:
+            logq += torch.where(active, torch.where(stop,F.logsigmoid(hazard),F.logsigmoid(-hazard)),0.)
+        finished = active & stop
+        selected[finished] = features[finished]
+        exits[finished] = loop + 1
+        active &= ~stop
+    hidden[ends] = selected
+    trace = torch.zeros((hidden.shape[0],2),device=hidden.device,dtype=torch.float32)
+    trace[ends] = torch.stack([exits.float(),logq],dim=-1)
+    model.ouro_exit_trace = trace if batch.capture_hidden_mode.is_full() else trace[ends]
+    return hidden
