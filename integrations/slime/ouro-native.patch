+"""Objective and sample-depth invariants for the native integration."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed as dist
+
+from slime_plugins.ouro_2a import model_forward_kwargs, post_process_rewards, policy_loss, check_on_policy
+
+
+def sample(reward, group, depth, length):
+    return SimpleNamespace(get_reward_value=lambda args: reward, group_index=group,
+                           train_metadata={"ouro_depth": depth}, response_length=length)
+
+
+def test_price_signal_keeps_its_scale_on_constant_outcome_batch():
+    args = SimpleNamespace(ouro_beta=.1, rollout_max_response_len=100, ouro_depth=None)
+    samples = [sample(0., 7, 2, 100), sample(0., 7, 4, 100)]
+    raw, advantages = post_process_rewards(args, samples)
+    assert raw == [0., 0.]
+    assert advantages == pytest.approx([.025, -.025])
+    args.ouro_beta = .2
+    assert post_process_rewards(args, samples)[1] == pytest.approx([.05, -.05])
+
+
+def test_group_centering_uses_explicit_ids_and_batch_outcome_scale():
+    args = SimpleNamespace(ouro_beta=0., rollout_max_response_len=100, ouro_depth=4)
+    samples = [sample(1., 9, 2, 20), sample(0., 3, 3, 7),
+               sample(0., 9, 4, 80), sample(0., 3, 3, 100)]
+    scale = 3 ** .5 / 4
+    assert post_process_rewards(args, samples)[1] == pytest.approx([.5 / scale, 0, -.5 / scale, 0])
+
+
+@pytest.mark.parametrize("metadata", [None, [{}], [None], [{"ouro_depth": 2}, {"ouro_depth": 4}],
+                                    [{"ouro_depth": 2.0}], [{"ouro_depth": True}]])
+def test_missing_or_mixed_depth_cannot_replay_as_default(metadata):
+    with pytest.raises(ValueError):
+        model_forward_kwargs(SimpleNamespace(ouro_depth=4), {"metadata": metadata})
+
+
+def test_actual_depth_overrides_run_default():
+    assert model_forward_kwargs(SimpleNamespace(ouro_depth=4),
+        {"metadata": [{"ouro_depth": 2}, {"ouro_depth": 2}]}) == {"ouro_depth": 2}
+
+
+def test_depth_metadata_survives_dp_partition(monkeypatch):
+    from slime.data.batch_builder import BatchBuilder
+    import slime.data.batch_builder as module
+    # Only replace object-store publication: exercise real partitioning and
+    # tensorization, which previously discarded train_metadata.
+    monkeypatch.setattr(module.ray, "put", lambda data: data)
+    args = SimpleNamespace(custom_reward_post_process_path=None,
+        custom_convert_samples_to_train_data_path=None, rollout_data_transport="object-store",
+        global_batch_size=4, micro_batch_size=1, use_dynamic_batch_size=False,
+        balance_data=False, balance_by_flops=False)
+    builder = BatchBuilder(args)
+    builder.train_parallel_config = dict(dp_size=2, cp_size=1, vpp_size=1,
+                                         microbatch_group_size_per_vp_stage=1)
+    metadata = [{"ouro_depth": k} for k in [2, 3, 4, 2]]
+    batches = builder.split_by_dp(dict(tokens=[[1, 2]] * 4, rollout_ids=list(range(4)), metadata=metadata))
+    for box in batches:
+        batch = box.inner
+        assert batch["metadata"] == [metadata[i] for i in batch["partition"]]
+
+
+def test_mismatched_sampler_is_rejected_before_update():
+    args = SimpleNamespace(num_steps_per_rollout=1, use_rollout_logprobs=False)
+    data = dict(log_probs=[torch.tensor([-1., -2.])], rollout_log_probs=[torch.tensor([-1., -2.01])])
+    with pytest.raises(ValueError, match="mismatch"):
+        check_on_policy(args, 0, data)
+
+
+@pytest.mark.parametrize("with_kl", [False, True])
+def test_native_packed_loss_matches_independent_fixed_budget_objective(tmp_path, with_kl):
+    if not torch.cuda.is_available():
+        pytest.skip("Native packed loss requires CUDA")
+    from megatron.core import parallel_state
+    torch.cuda.set_device(0)
+    dist.init_process_group("nccl", init_method=f"file://{tmp_path}/init", rank=0, world_size=1)
+    parallel_state.initialize_model_parallel(tensor_model_parallel_size=1, pipeline_model_parallel_size=1)
+    try:
+        torch.manual_seed(42)
+        logits = torch.randn(1, 7, 128, device="cuda", requires_grad=True)
+        reference = logits.detach().clone().requires_grad_(True)
+        tokens = [torch.tensor([1, 2, 3, 4], device="cuda"), torch.tensor([5, 6, 7], device="cuda")]
+        # Predict response tokens 3,4 and 7 from the preceding positions in
+        # each independent sequence, despite unequal response lengths.
+        expected_logp = reference[0, [1, 2, 5]].log_softmax(-1).gather(1,
+            torch.tensor([[3], [4], [7]], device="cuda")).flatten()
+        old = expected_logp.detach() + torch.tensor([.1, -.3, .4], device="cuda")
+        advantages = torch.tensor([1., 1., -1.], device="cuda")
+        args = SimpleNamespace(calculate_per_token_loss=False, context_parallel_size=1,
+            rollout_temperature=1., rollout_top_p=1., log_probs_chunk_size=-1, allgather_cp=False,
+            eps_clip=.2, eps_clip_high=.2, use_kl_loss=with_kl, kl_loss_coef=.001 if with_kl else 0., rollout_max_response_len=100)
+        ref = old + torch.tensor([.4, -.2, .3], device="cuda")
+        batch = dict(unconcat_tokens=tokens, total_lengths=[4, 3], response_lengths=[2, 1],
+            log_probs=[old[:2], old[2:]], advantages=[advantages[:2], advantages[2:]],
+            ref_log_probs=[ref[:2], ref[2:]],
+            loss_masks=[torch.ones(2, device="cuda"), torch.ones(1, device="cuda")])
+        actual, _ = policy_loss(args, batch, logits, lambda _: pytest.fail("Must not use length-normalized reducer"))
+        ratio = (expected_logp - old).exp()
+        expected = -torch.minimum(ratio * advantages, ratio.clamp(.8, 1.2) * advantages).sum() / 100
+        if with_kl:
+            delta = ref - expected_logp
+            expected += .001*(delta.exp()-delta-1).sum()/100
+        torch.testing.assert_close(actual, expected)
+        actual.backward()
+        expected.backward()
+        torch.testing.assert_close(logits.grad, reference.grad, atol=1e-7, rtol=1e-5)
+    finally:
+        parallel_state.destroy_model_parallel()
+        dist.destroy_process_group()
