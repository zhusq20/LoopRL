+++ b/slime_plugins/ouro_2a.py
@@ -0,0 +1,151 @@
+"""Fixed/stratified sequence-depth 2a hooks for native slime training.
+
+The learned depth policy is not implemented here. Its score must eventually
+be added once per trajectory; the token gate is not a substitute for it.
+"""
+
+import math
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def rollout_correction(args, old, sampled):
+    """Detached token-wise p_old / q weights, separate from PPO's p / p_old."""
+    from slime.utils.ppo_utils import importance_weights
+    delta = old.detach().float() - sampled.detach().float()
+    ratio = delta.exp()
+    if not torch.isfinite(ratio).all():
+        raise ValueError("Nonfinite Ouro behavior importance ratios")
+    low, high = getattr(args,"tis_clip_low",0.), getattr(args,"tis_clip",2.)
+    if low != 0 or not math.isfinite(high) or high < 1:
+        raise ValueError("Ouro TIS requires lower bound 0 and finite upper bound >= 1")
+    weights = importance_weights(ratio,mode="tis",low=low,high=high).detach()
+    if not weights.sum() > 0:
+        raise ValueError("Ouro TIS rejected all learning signal")
+    return weights, dict(tis_weight_mean=weights.mean(),
+        tis_clip_fraction=(ratio>high).float().mean(),
+        tis_ess_fraction=weights.sum().square()/(weights.numel()*weights.square().sum()),
+        mismatch_mean_abs=delta.abs().mean(), mismatch_k3=(delta.expm1()-delta).mean())
+
+
+def check_on_policy(args, rollout_id, rollout_data):
+    """Reject stale weights/depth/KV mismatches before the native optimizer runs."""
+    if args.num_steps_per_rollout != 1 or args.use_rollout_logprobs:
+        raise ValueError("Ouro initial acceptance requires one update and explicit old-policy recomputation")
+    old = torch.cat(rollout_data["log_probs"])
+    sampled = torch.cat(rollout_data["rollout_log_probs"]).to(old.device)
+    if old.shape != sampled.shape or not torch.isfinite(old).all() or not torch.isfinite(sampled).all():
+        raise ValueError("Invalid Ouro sampler/recompute log probabilities")
+    error = (old - sampled).abs().max().item()
+    use_tis = getattr(args,"use_tis",False)
+    if use_tis:
+        if getattr(args,"ouro_rollout_correction",None) != "tis":
+            raise ValueError("Ouro TIS must be explicitly recorded in the protocol")
+        _, metrics = rollout_correction(args,old,sampled)
+        rollout_data.update({"ouro_"+key:value for key,value in metrics.items()})
+    elif error > 1e-3:
+        raise ValueError(f"Ouro sampler/recompute mismatch {error:.6g} exceeds 0.001")
+    rollout_data["ouro_logprob_max_error"] = torch.tensor(error, device=old.device)
+    logger.info("Ouro rollout %s sampler/recompute max logprob error %.8g", rollout_id, error)
+
+
+def model_forward_kwargs(args, batch):
+    metadata = batch.get("metadata")
+    if not metadata or any(m is None or "ouro_depth" not in m for m in metadata):
+        raise ValueError("Every Ouro training sample must record its executed ouro_depth")
+    depths = [m["ouro_depth"] for m in metadata]
+    if any(type(k) is not int or k not in (2, 3, 4) for k in depths):
+        raise ValueError("Ouro 2a requires integer sample depths in {2,3,4}")
+    if len(set(depths)) != 1:
+        raise ValueError("Ouro microbatches must have one depth; use micro-batch-size=1 or group by depth")
+    return {"ouro_depth": depths[0]}
+
+
+def post_process_rewards(args, samples):
+    """Group baseline after pricing; normalize by unpriced batch outcome std."""
+    beta = getattr(args, "ouro_beta", 0.)
+    budget = args.rollout_max_response_len
+    if beta < 0 or budget < 1:
+        raise ValueError("Invalid Ouro compute price or generation budget")
+    raw = [sample.get_reward_value(args) for sample in samples]
+    if not raw or not all(math.isfinite(value) for value in raw):
+        raise ValueError("Ouro rewards must be finite and nonempty")
+    groups, priced = {}, []
+    for i, (sample, reward) in enumerate(zip(samples, raw, strict=True)):
+        # A fixed-depth engine may use the run's depth. Multi-engine rollout
+        # must stamp the chosen depth before handing the sample to slime.
+        metadata = dict(sample.train_metadata or {})
+        depth = metadata.get("ouro_depth", getattr(args, "ouro_depth", None))
+        if type(depth) is not int or depth not in (2, 3, 4):
+            raise ValueError("Rollout must record an executed Ouro depth")
+        metadata["ouro_depth"] = depth
+        sample.train_metadata = metadata
+        group = sample.group_index
+        if group is None:
+            raise ValueError("Ouro reward centering requires explicit prompt group_index")
+        groups.setdefault(group, []).append(i)
+        priced.append(reward - beta * depth * sample.response_length / (4 * budget))
+    values = torch.tensor(priced, dtype=torch.float32)
+    scale = torch.tensor(raw, dtype=torch.float32).std(correction=0)
+    scale = scale if scale > 1e-8 else torch.ones_like(scale)
+    result = values.clone()
+    for indices in groups.values():
+        result[indices] = (values[indices] - values[indices].mean()) / scale
+    return raw, result.tolist()
+
+
+def policy_loss(args, batch, logits, sum_of_sample_mean):
+    """Sum token PPO scores divided by a FIXED response budget, then batch mean.
+
+slime's outer loss function supplies the global-batch normalization. Its
+per-sample response-length reducer must not normalize the objective again.
+"""
+    from slime.backends.megatron_utils.loss import get_log_probs_and_entropy, _maybe_capture_log_probs
+
+    if args.calculate_per_token_loss or args.context_parallel_size != 1:
+        raise ValueError("Initial Ouro loss requires sequence mean and CP=1")
+    if args.rollout_temperature != 1 or args.rollout_top_p != 1:
+        raise ValueError("Ouro initial policy replay requires temperature=top_p=1")
+    _, output = get_log_probs_and_entropy(logits, args=args,
+        unconcat_tokens=batch["unconcat_tokens"], total_lengths=batch["total_lengths"],
+        response_lengths=batch["response_lengths"], with_entropy=False)
+    current = torch.cat(output["log_probs"])
+    _maybe_capture_log_probs(batch, output["log_probs"])
+    reuse = getattr(args, "ouro_reuse_old_log_probs", False)
+    old = current.detach() if reuse else torch.cat(batch["log_probs"]).detach()
+    if reuse:
+        from slime_plugins.ouro_training import record_reuse
+        record_reuse(args, batch, current,
+                     torch.cat(output["exit_log_probs"]) if getattr(args, "ouro_token_exit", False) else None)
+    elif getattr(args, "rollout_data_postprocess_path", None) == "slime_plugins.ouro_2a.check_on_policy":
+        error = (current.detach() - old).abs().max().item()
+        if not math.isfinite(error) or error > 1e-3:
+            raise ValueError(f"Ouro grad/no-grad replay mismatch {error:.6g} exceeds 0.001")
+    advantages = torch.cat(batch["advantages"]).detach()
+    mask = torch.cat(batch["loss_masks"])
+    ratio = (current - old).exp()
+    clipped = ratio.clamp(1 - args.eps_clip, 1 + args.eps_clip_high)
+    pg_tokens = -torch.minimum(ratio * advantages, clipped * advantages)
+    correction_metrics = {}
+    if getattr(args,"use_tis",False):
+        if getattr(args,"ouro_rollout_correction",None) != "tis":
+            raise ValueError("Ouro custom loss requires explicit TIS protocol")
+        sampled = torch.cat(batch["rollout_log_probs"]).to(old.device)
+        weights, correction_metrics = rollout_correction(args,old,sampled)
+        pg_tokens = pg_tokens * weights
+    pg = (pg_tokens * mask).sum()
+    kl = torch.zeros_like(pg)
+    if args.use_kl_loss and args.kl_loss_coef:
+        delta = torch.cat(batch["ref_log_probs"]).detach() - current
+        kl = ((delta.exp() - delta - 1) * mask).sum()
+    budget = args.rollout_max_response_len
+    loss = (pg + args.kl_loss_coef * kl) / budget
+    return loss, {"loss": loss.detach(), "pg_loss": pg.detach() / budget,
+                  "kl_loss": kl.detach() / budget,
+                  # The outer logger divides by sample count, not microbatches.
+                  # Exact token-weighted batch diagnostics are in consistency.jsonl.
+                  **{k:v.detach()*max(1, len(batch["response_lengths"]))
+                     for k,v in correction_metrics.items()}}
diff --git a/slime_plugins/ouro_attention.py b/slime_plugins/ouro_attention.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ff5af40fcf88af6ee3c48249f5e1e03780ec8cc
--- /dev/null
+++ b/slime_plugins/ouro_attention.py
@@ -0,0 +1,154 @@
+"""Reference batched SDPA and opt-in FP32 paged attention for Ouro."""
+import torch
+from torch.nn import functional as F
+from sglang.srt.layers.attention.torch_native_backend import TorchNativeAttnBackend
+
+
+class OuroBatchedDecode(TorchNativeAttnBackend):
+    def init_forward_metadata(self, batch):
+        super().init_forward_metadata(batch)
+        self.decode_tokens = self.decode_mask = None
+        if batch.forward_mode.is_decode():
+            lengths = batch.seq_lens_cpu
+            if lengths is None:
+                raise ValueError("Batched Ouro decode needs CPU length metadata")
+            maximum = int(lengths.max())
+            mask = torch.arange(maximum, device=batch.seq_lens.device)[None, :] < batch.seq_lens[:, None]
+            indices = self.req_to_token_pool.req_to_token[batch.req_pool_indices, :maximum]
+            # Padding slots may never have been initialized. Do not read them.
+            self.decode_tokens = indices.masked_fill(~mask, 0).long()
+            self.decode_mask = mask[:, None, None, :]
+
+    def _run_sdpa_forward_decode(self, query, output, k_cache, v_cache, req_to_token,
+            req_pool_indices, seq_lens, encoder_lens=None, scaling=None, enable_gqa=False,
+            causal=False, is_cross_attn=False, sliding_window_size=None):
+        if encoder_lens is not None or causal or is_cross_attn or sliding_window_size not in (None, -1):
+            raise ValueError("Ouro batched decode supports plain causal-decoder history only")
+        if self.decode_tokens is None or len(self.decode_tokens) != len(query):
+            raise ValueError("Missing or stale decode metadata")
+        keys = k_cache[self.decode_tokens].permute(0, 2, 1, 3).to(query.dtype)
+        values = v_cache[self.decode_tokens].permute(0, 2, 1, 3).to(query.dtype)
+        result = F.scaled_dot_product_attention(query.unsqueeze(2), keys, values,
+            attn_mask=self.decode_mask, enable_gqa=enable_gqa, scale=scaling, dropout_p=0.)
+        output.copy_(result.squeeze(2))
+        return output
+
+
+class OuroPagedAttention(OuroBatchedDecode):
+    """Read paged KV directly on decode; cache prefill metadata once per batch."""
+
+    def init_cuda_graph_state(self, max_bs, max_num_tokens):
+        # The request page table and SGLang's graph input buffers already have
+        # stable addresses. Only scratch storage needs separate allocation.
+        self.graph_maximum = self.req_to_token_pool.req_to_token.shape[1]
+        self.graph_workspaces = {}
+
+    def get_cuda_graph_seq_len_fill_value(self):
+        return 1
+
+    def init_forward_metadata_out_graph(self, batch, in_capture=False):
+        if not batch.forward_mode.is_decode_or_idle():
+            raise ValueError("Ouro CUDA graphs support decode only")
+        self.maximum = self.graph_maximum
+        self.workspace = self.graph_workspaces.get(batch.batch_size)
+        self.graph_batch_size = batch.batch_size
+        self.swa_out_cache_loc = None
+
+    def init_forward_metadata(self, batch):
+        TorchNativeAttnBackend.init_forward_metadata(self, batch)
+        self.graph_batch_size = None
+        if batch.seq_lens_cpu is None:
+            raise ValueError("Ouro paged attention needs CPU sequence lengths")
+        self.maximum = int(batch.seq_lens_cpu.max())
+        self.workspace = None
+        self.prefill = []
+        self.single_token_extend = False
+        if not batch.forward_mode.is_decode():
+            lengths = batch.extend_seq_lens_cpu
+            prefixes = batch.extend_prefix_lens_cpu
+            if lengths is None or prefixes is None:
+                raise ValueError("Ouro prefill needs CPU extension metadata")
+            self.single_token_extend = all(length == 1 for length in lengths)
+            # Index on GPU once, instead of extracting req_pool_indices once per
+            # request per physical layer per loop (a device synchronization).
+            pages = self.req_to_token_pool.req_to_token[batch.req_pool_indices, :self.maximum]
+            start = 0
+            for i, (length, prefix) in enumerate(zip(lengths, prefixes, strict=True)):
+                total = length + prefix
+                mask = None
+                if prefix and length > 1:
+                    qpos = prefix + torch.arange(length, device=pages.device)
+                    mask = torch.arange(total, device=pages.device)[None, :] <= qpos[:, None]
+                self.prefill.append((start, length, prefix, pages[i, :total].long(), mask))
+                start += length
+
+    def _paged(self, query, output, k_cache, v_cache, pages, requests, lengths, scale):
+        from slime_plugins.ouro_kernels import paged_decode
+        if self.workspace is None:
+            b, h, d = query.shape
+            splits = (self.maximum + 255)//256
+            self.workspace = (
+                torch.empty((b, h, splits, d), device=query.device, dtype=torch.float32),
+                torch.empty((b, h, splits), device=query.device, dtype=torch.float32),
+                torch.empty((b, h, splits), device=query.device, dtype=torch.float32))
+            if self.graph_batch_size is not None:
+                self.graph_workspaces[self.graph_batch_size] = self.workspace
+        return paged_decode(query, k_cache, v_cache, pages, requests, lengths,
+                            self.maximum, scale, output, self.workspace)
+
+    def _run_sdpa_forward_decode(self, query, output, k_cache, v_cache, req_to_token,
+            req_pool_indices, seq_lens, encoder_lens=None, scaling=None, enable_gqa=False,
+            causal=False, is_cross_attn=False, sliding_window_size=None):
+        if encoder_lens is not None or causal or is_cross_attn or sliding_window_size not in (None, -1):
+            raise ValueError("Ouro paged decode supports causal-decoder history only")
+        return self._paged(query, output, k_cache, v_cache, req_to_token,
+                           req_pool_indices, seq_lens, scaling)
+
+    def _run_sdpa_forward_extend(self, query, output, k_cache, v_cache, req_to_token,
+            req_pool_indices, seq_lens, extend_prefix_lens, extend_seq_lens,
+            encoder_lens=None, scaling=None, enable_gqa=False, causal=False,
+            is_cross_attn=False, sliding_window_size=None):
+        if encoder_lens is not None or not causal or is_cross_attn or sliding_window_size not in (None, -1):
+            raise ValueError("Ouro prefill supports plain causal attention only")
+        if self.single_token_extend:
+            return self._paged(query, output, k_cache, v_cache, req_to_token,
+                               req_pool_indices, seq_lens, scaling)
+        for start, length, prefix, tokens, mask in self.prefill:
+            if not length:
+                continue
+            q = query[start:start+length].transpose(0, 1).unsqueeze(0)
+            k = k_cache[tokens].transpose(0, 1).unsqueeze(0)
+            v = v_cache[tokens].transpose(0, 1).unsqueeze(0)
+            result = F.scaled_dot_product_attention(q, k, v, attn_mask=mask,
+                is_causal=prefix == 0, enable_gqa=enable_gqa, scale=scaling, dropout_p=0.)
+            output[start:start+length].copy_(result.squeeze(0).transpose(0, 1))
+        return output
+
+
+def install():
+    from sglang.srt.layers.attention.attention_registry import ATTENTION_BACKENDS
+    original = ATTENTION_BACKENDS["torch_native"]
+    if getattr(original, "ouro_dispatch", False):
+        return
+
+    def create(runner):
+        config = runner.model_config.hf_config
+        if config.model_type == "ouro" and getattr(config, "ouro_paged_attention", False):
+            return OuroPagedAttention(runner)
+        if config.model_type == "ouro" and getattr(config, "ouro_batched_decode", False):
+            return OuroBatchedDecode(runner)
+        return original(runner)
+
+    create.ouro_dispatch = True
+    ATTENTION_BACKENDS["torch_native"] = create
+    triton_original = ATTENTION_BACKENDS["triton"]
+
+    def create_triton(runner):
+        config = runner.model_config.hf_config
+        if config.model_type == "ouro" and getattr(config, "ouro_paged_attention", False):
+            return OuroPagedAttention(runner)
+        return triton_original(runner)
+
+    # SGLang intentionally disables graphs for torch_native. Register Ouro's
+    # actual Triton implementation on the graph-capable backend as well.
+    ATTENTION_BACKENDS["triton"] = create_triton
