@@ -0,0 +1,27 @@
+"""Ouro checkpoint mapping for one shared stack, regardless of loop count."""
+
+import re
+import torch
+
+from .common import strip_mcore_wrappers
+from .qwen import qwen_hf_tensor
+
+
+def ouro_hf_tensor(name, reader, config):
+    name = strip_mcore_wrappers(name)
+    if name.startswith("sequence_depth_head.") and f"model.{name}" in reader:
+        return reader.get_tensor(f"model.{name}")
+    if name == "sequence_depth_head.weight":
+        return torch.zeros(3, config.hidden_size)
+    if name == "sequence_depth_head.bias":
+        return torch.tensor([.1, .1, .8]).log()
+    if name in {"early_exit_gate.weight", "early_exit_gate.bias"}:
+        return reader.get_tensor(f"model.{name}")
+    match = re.fullmatch(r"decoder\.layers\.(\d+)\.(post_self_attn_layernorm|post_mlp_layernorm)\.weight", name)
+    if match:
+        layer, norm = match.groups()
+        norm = "input_layernorm_2" if norm == "post_self_attn_layernorm" else "post_attention_layernorm_2"
+        return reader.get_tensor(f"model.layers.{layer}.{norm}.weight")
+    # Local Megatron layer specs keep the input norm separate from QKV.
+    name = name.replace(".input_layernorm.weight", ".self_attention.linear_qkv.layer_norm_weight")
+    return qwen_hf_tensor(name, reader, config)
