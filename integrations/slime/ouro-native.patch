@@ -0,0 +1,167 @@
+"""Compare native Megatron Ouro with the pinned Hugging Face implementation."""
+
+import os
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed as dist
+from torch.nn import functional as F
+from transformers import AutoConfig, AutoModelForCausalLM
+
+from megatron.core import parallel_state
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.tensor_parallel.random import model_parallel_cuda_manual_seed
+from megatron.core.transformer.transformer_config import TransformerConfig
+
+from slime.backends.megatron_utils.hf_to_megatron.ouro import ouro_hf_tensor
+from slime.backends.megatron_utils.megatron_to_hf.ouro import convert_ouro_to_hf
+from slime_plugins.models.ouro import OuroGPTModel, ouro_block_spec
+
+NUM_GPUS = 1
+
+
+@pytest.fixture(scope="module", autouse=True)
+def distributed(tmp_path_factory):
+    if not torch.cuda.is_available():
+        pytest.skip("Ouro numerical acceptance needs one CUDA GPU")
+    torch.set_num_threads(4)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.cuda.set_device(0)
+    rendezvous = tmp_path_factory.mktemp("ouro-dist") / "init"
+    dist.init_process_group("nccl", init_method=f"file://{rendezvous}", rank=0, world_size=1)
+    parallel_state.initialize_model_parallel(tensor_model_parallel_size=1, pipeline_model_parallel_size=1)
+    model_parallel_cuda_manual_seed(42)
+    yield
+    parallel_state.destroy_model_parallel()
+    dist.destroy_process_group()
+
+
+def models(kv_heads=4, recompute=False):
+    path = os.environ["OURO_HF_CHECKPOINT"]
+    hf_config = AutoConfig.from_pretrained(path, trust_remote_code=True)
+    for name, value in dict(num_hidden_layers=2, hidden_size=64, intermediate_size=128,
+            num_attention_heads=4, num_key_value_heads=kv_heads, head_dim=16, vocab_size=128,
+            max_position_embeddings=128, layer_types=["full_attention"] * 2).items():
+        setattr(hf_config, name, value)
+    hf_config._attn_implementation = "sdpa"
+    torch.manual_seed(42)
+    hf = AutoModelForCausalLM.from_config(hf_config, trust_remote_code=True).float().cuda()
+    config = TransformerConfig(num_layers=2, hidden_size=64, num_attention_heads=4,
+        num_query_groups=kv_heads, kv_channels=16, ffn_hidden_size=128,
+        hidden_dropout=0., attention_dropout=0., normalization="RMSNorm",
+        layernorm_epsilon=1e-6, gated_linear_unit=True, activation_func=F.silu,
+        add_bias_linear=False, attention_softmax_in_fp32=True, params_dtype=torch.float32,
+        use_cpu_initialization=True, persist_layer_norm=False, gradient_accumulation_fusion=False,
+        bias_activation_fusion=False, masked_softmax_fusion=False, bias_dropout_fusion=False,
+        apply_rope_fusion=False,
+        recompute_granularity="full" if recompute else None,
+        recompute_method="uniform" if recompute else None,
+        recompute_num_layers=1 if recompute else None)
+    native = OuroGPTModel(config=config, transformer_layer_spec=ouro_block_spec(config),
+        vocab_size=128, max_sequence_length=128, share_embeddings_and_output_weights=False,
+        position_embedding_type="rope", rotary_base=hf_config.rope_theta).cuda()
+
+    class Reader(dict):
+        def get_tensor(self, name):
+            return self[name]
+
+    with torch.no_grad():
+        covered = set()
+        conversion_args = SimpleNamespace(hidden_size=64, num_attention_heads=4,
+                                           num_query_groups=kv_heads, kv_channels=16)
+        for name, param in native.named_parameters():
+            param.copy_(ouro_hf_tensor(name, Reader(hf.state_dict()), hf_config))
+            covered.update(key for key, _ in convert_ouro_to_hf(conversion_args, name, param))
+        assert covered == set(hf.state_dict()), "Native mapping must cover the actual HF model schema"
+    return hf, native, hf_config, Reader
+
+
+@pytest.mark.parametrize("depth", [1, 2, 3, 4])
+@pytest.mark.parametrize("kv_heads", [2, 4])
+def test_logits_and_shared_parameter_gradients(depth, kv_heads):
+    hf, native, hf_config, Reader = models(kv_heads)
+    tokens = torch.tensor([[1, 15, 27, 90, 6, 32, 4, 77]], device="cuda")
+    hf.model.total_ut_steps = depth
+    expected = hf(tokens, use_cache=False, exit_at_step=depth - 1).logits
+    calls = []
+    handle = native.decoder.layers[0].register_forward_hook(lambda *args: calls.append(1))
+    actual = native(tokens, ouro_depth=depth)
+    handle.remove()
+    assert len(calls) == depth
+    assert len(native.decoder.layers) == 2
+    torch.testing.assert_close(actual, expected, atol=2e-5, rtol=2e-5)
+    labels = tokens.roll(-1, 1)
+    for logits in [expected, actual]:
+        F.cross_entropy(logits.reshape(-1, 128), labels.reshape(-1)).backward()
+    gradients = Reader({name: param.grad for name, param in hf.named_parameters()})
+    for name, parameter in native.named_parameters():
+        if name.startswith("early_exit_gate."):
+            assert parameter.grad is None
+            continue
+        expected_grad = ouro_hf_tensor(name, gradients, hf_config)
+        torch.testing.assert_close(parameter.grad, expected_grad, atol=3e-5, rtol=3e-4)
+
+
+def test_packed_sequences_are_independent():
+    hf, native, _, _ = models()
+    sequences = [torch.tensor([[1, 7, 5, 14, 2]], device="cuda"),
+                 torch.tensor([[1, 64, 9]], device="cuda")]
+    hf.model.total_ut_steps = 3
+    expected = torch.cat([hf(x, use_cache=False, exit_at_step=2).logits for x in sequences], dim=1)
+    boundaries = torch.tensor([0, 5, 8], device="cuda", dtype=torch.int32)
+    packed = PackedSeqParams(cu_seqlens_q=boundaries, cu_seqlens_kv=boundaries,
+        max_seqlen_q=5, max_seqlen_kv=5, qkv_format="thd")
+    actual = native(torch.cat(sequences, dim=1), packed_seq_params=packed, ouro_depth=3)
+    torch.testing.assert_close(actual, expected, atol=2e-5, rtol=2e-5)
+
+
+def test_invalid_depth_cannot_silently_change_policy():
+    _, native, _, _ = models()
+    for depth in [0, 5, True, 2.0, [2, 3]]:
+        with pytest.raises(ValueError, match="integer depth"):
+            native(torch.tensor([[1, 2]], device="cuda"), ouro_depth=depth)
+
+
+def test_sequence_head_uses_only_prompt_and_backpropagates_to_shared_stack():
+    _, native, _, _ = models()
+    native.learned_depth = True
+    native.sequence_depth_head = torch.nn.Linear(64, 3, device="cuda")
+    # Nonzero weights exercise gradient flow into the prompt encoder too.
+    tokens = torch.tensor([[1, 7, 5, 14, 2, 19]], device="cuda")
+    result = native(tokens, ouro_depth=2, ouro_prompt_length=3)
+    q = result.ouro_depth_log_probs
+    independent = native.sequence_depth_head(native(tokens[:, :3], ouro_depth=4,
+                                ouro_return_prompt_feature=True)).log_softmax(-1)
+    torch.testing.assert_close(q, independent)
+    changed = tokens.clone()
+    changed[:, 3:] = 8
+    torch.testing.assert_close(native(changed, ouro_depth=3, ouro_prompt_length=3).ouro_depth_log_probs, q)
+    (-q[0]).backward()
+    assert native.sequence_depth_head.weight.grad.abs().sum() > 0
+    assert native.embedding.word_embeddings.weight.grad[7].abs().sum() > 0
+    assert native.embedding.word_embeddings.weight.grad[19].abs().sum() == 0
+
+
+@pytest.mark.parametrize("depth", [2, 3, 4])
+def test_full_activation_recompute_matches_shared_parameter_gradients(depth):
+    _, ordinary, _, _ = models()
+    _, checkpointed, _, _ = models(recompute=True)
+    checkpointed.load_state_dict(ordinary.state_dict())
+    tokens = torch.tensor([[1, 7, 5, 14, 2, 19]], device="cuda")
+    boundaries = torch.tensor([0, 6], device="cuda", dtype=torch.int32)
+    packed = PackedSeqParams(cu_seqlens_q=boundaries, cu_seqlens_kv=boundaries,
+                            max_seqlen_q=6, max_seqlen_kv=6, qkv_format="thd")
+    outputs = []
+    for model in (ordinary, checkpointed):
+        model.train()
+        output = model(tokens, packed_seq_params=packed, ouro_depth=depth)
+        outputs.append(output.detach())
+        F.cross_entropy(output.reshape(-1, 128), tokens.roll(-1, 1).flatten()).backward()
+    torch.testing.assert_close(outputs[0], outputs[1], atol=0, rtol=0)
+    for (name, left), (_, right) in zip(ordinary.named_parameters(), checkpointed.named_parameters(), strict=True):
+        if name.startswith("early_exit_gate."):
+            assert left.grad is right.grad is None
+        else:
+            torch.testing.assert_close(left.grad, right.grad, atol=3e-6, rtol=3e-5)
