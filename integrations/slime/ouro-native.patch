@@ -0,0 +1,73 @@
+"""Round-trip the full Ouro parameter schema, including GQA packing and gates."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from slime.backends.megatron_utils.hf_to_megatron.ouro import ouro_hf_tensor
+from slime.backends.megatron_utils.megatron_to_hf.ouro import convert_ouro_to_hf
+
+NUM_GPUS = 0
+
+
+@pytest.mark.parametrize("kv_heads", [2, 4])
+@pytest.mark.parametrize("local_norm", [False, True])
+def test_ouro_roundtrip_preserves_shared_stack_and_gate(kv_heads, local_norm):
+    hidden, heads, head_dim, ffn, layers, vocab = 16, 4, 4, 24, 2, 32
+    config = SimpleNamespace(hidden_size=hidden, num_attention_heads=heads,
+        num_key_value_heads=kv_heads, head_dim=head_dim, tie_word_embeddings=False)
+    args = SimpleNamespace(hidden_size=hidden, num_attention_heads=heads,
+        num_query_groups=kv_heads, kv_channels=head_dim)
+    generator = torch.Generator().manual_seed(7)
+    def tensor(*shape):
+        return torch.randn(*shape, generator=generator)
+
+    hf = {
+        "model.embed_tokens.weight": tensor(vocab, hidden),
+        "lm_head.weight": tensor(vocab, hidden),
+        "model.norm.weight": tensor(hidden),
+        "model.early_exit_gate.weight": tensor(1, hidden),
+        "model.early_exit_gate.bias": tensor(1),
+    }
+    names = ["embedding.word_embeddings.weight", "output_layer.weight", "decoder.final_layernorm.weight",
+             "early_exit_gate.weight", "early_exit_gate.bias"]
+    for layer in range(layers):
+        prefix = f"model.layers.{layer}"
+        for projection in "qkv":
+            hf[f"{prefix}.self_attn.{projection}_proj.weight"] = tensor(
+                (heads if projection == "q" else kv_heads) * head_dim, hidden)
+        hf[f"{prefix}.self_attn.o_proj.weight"] = tensor(hidden, heads * head_dim)
+        hf[f"{prefix}.input_layernorm.weight"] = tensor(hidden)
+        hf[f"{prefix}.input_layernorm_2.weight"] = tensor(hidden)
+        hf[f"{prefix}.post_attention_layernorm.weight"] = tensor(hidden)
+        hf[f"{prefix}.post_attention_layernorm_2.weight"] = tensor(hidden)
+        for projection in ["gate", "up"]:
+            hf[f"{prefix}.mlp.{projection}_proj.weight"] = tensor(ffn, hidden)
+        hf[f"{prefix}.mlp.down_proj.weight"] = tensor(hidden, ffn)
+        names.extend(f"decoder.layers.{layer}.{suffix}" for suffix in [
+            "self_attention.linear_qkv.weight", "self_attention.linear_proj.weight",
+            "input_layernorm.weight" if local_norm else "self_attention.linear_qkv.layer_norm_weight",
+            "pre_mlp_layernorm.weight" if local_norm else "mlp.linear_fc1.layer_norm_weight",
+            "post_self_attn_layernorm.weight", "post_mlp_layernorm.weight",
+            "mlp.linear_fc1.weight", "mlp.linear_fc2.weight"])
+
+    class Reader(dict):
+        def get_tensor(self, name):
+            return self[name]
+
+    reader = Reader(hf)
+    restored = {}
+    for name in names:
+        value = ouro_hf_tensor("module.module." + name, reader, config)
+        for key, weight in convert_ouro_to_hf(args, name, value):
+            assert key not in restored
+            restored[key] = weight
+    assert restored.keys() == hf.keys()
+    for key in hf:
+        torch.testing.assert_close(restored[key], hf[key], rtol=0, atol=0)
+
+
+def test_ouro_rejects_unknown_parameter():
+    with pytest.raises(KeyError):
+        ouro_hf_tensor("decoder.layers.0.unknown.weight", {}, SimpleNamespace())
