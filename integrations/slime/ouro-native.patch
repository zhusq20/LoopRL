@@ -0,0 +1,18 @@
+"""Select serving groups that intentionally share one trainable Ouro policy."""
+
+
+def updatable_server(args, servers):
+    selected = [(name, server) for name, server in servers.items() if server.update_weights]
+    if not getattr(args, "ouro_shared_depth_engines", False):
+        return selected[0][1] if selected else None
+    expected = ({"token_exit"} if args.ouro_arm == "token_exit" else
+                {"depth4"} if args.ouro_arm == "fixed" else {"depth2", "depth3", "depth4"})
+    if {name for name, _ in selected} != expected:
+        raise ValueError(f"Ouro shared-weight engines must be exactly {sorted(expected)}")
+    from .engine_group import RolloutServer
+
+    # The groups retain their own depth overrides and router. This view combines
+    # only weight synchronization/recovery and shares the actual group objects,
+    # so clearing reconnection markers affects every physical engine.
+    return RolloutServer(server_groups=[g for _, server in selected for g in server.server_groups],
+                         model_name="ouro_shared_depths", update_weights=True)
