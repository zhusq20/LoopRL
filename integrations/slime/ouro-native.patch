diff --git a/slime_plugins/models/ouro.py b/slime_plugins/models/ouro.py
new file mode 100644
index 0000000..ee84aef
--- /dev/null
+++ b/slime_plugins/models/ouro.py
@@ -0,0 +1,203 @@
+"""Ouro's shared recurrent decoder on the native Megatron training backend.
+
+Use ``--spec slime_plugins.models.ouro get_ouro_model_provider``. Loop count
+is an execution choice, never a multiplier for the number of parameters.
+The first implementation supports TP=PP=CP=1, including packed sequences.
+"""
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+from megatron.core.models.gpt import GPTModel
+from megatron.core.models.gpt.gpt_layer_specs import get_gpt_layer_local_spec
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.transformer_block import TransformerBlockSubmodules
+from megatron.core.transformer.transformer_layer import TransformerLayer
+
+from slime.utils.model_config import load_hf_config
+
+
+class OuroRMSNorm(nn.Module):
+    """Match the checkpoint's FP32 reduction and multiply order exactly."""
+
+    returns_residual = False
+
+    def __init__(self, config, hidden_size, eps=1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size, dtype=config.params_dtype))
+        self.eps = eps
+
+    def forward(self, hidden):
+        value = hidden.float()
+        value = value * torch.rsqrt(value.square().mean(-1, keepdim=True) + self.eps)
+        return self.weight * value.to(hidden.dtype)
+
+
+class OuroSDPAttention(MegatronModule):
+    """FP32-capable packed attention using Megatron's native Q/K/V projections."""
+
+    def __init__(self, config, layer_number, attn_mask_type, attention_type, **kwargs):
+        super().__init__(config=config)
+        if config.context_parallel_size != 1:
+            raise ValueError("Ouro SDPA currently requires context_parallel_size=1")
+        if config.attention_dropout != 0 or config.apply_query_key_layer_scaling:
+            raise ValueError("Ouro requires zero attention dropout and unscaled QK layers")
+        self.scale = config.kv_channels ** -0.5
+
+    def _attend(self, query, key, value, mask=None):
+        if query.shape[1] != key.shape[1]:
+            repeats = query.shape[1] // key.shape[1]
+            key = key.repeat_interleave(repeats, dim=1)
+            value = value.repeat_interleave(repeats, dim=1)
+        # Megatron's bool masks mark excluded entries; SDPA marks allowed ones.
+        mask = ~mask if mask is not None and mask.dtype == torch.bool else mask
+        return F.scaled_dot_product_attention(query, key, value, attn_mask=mask,
+            dropout_p=0., is_causal=mask is None, scale=self.scale)
+
+    def forward(self, query, key, value, attention_mask=None, attn_mask_type=None,
+                attention_bias=None, packed_seq_params=None):
+        if attention_bias is not None:
+            raise ValueError("Ouro does not use attention bias")
+        if packed_seq_params is None:
+            # [S,B,H,D] -> [B,H,S,D] -> [S,B,H*D]
+            output = self._attend(query.permute(1, 2, 0, 3), key.permute(1, 2, 0, 3),
+                                 value.permute(1, 2, 0, 3), attention_mask)
+            return output.permute(2, 0, 1, 3).flatten(2).contiguous()
+        if packed_seq_params.qkv_format != "thd" or attention_mask is not None:
+            raise ValueError("Ouro packed attention requires THD and implicit causal masking")
+        boundaries = getattr(packed_seq_params, "cu_seqlens_q_cpu", None)
+        if boundaries is None:
+            boundaries = packed_seq_params.cu_seqlens_q.tolist()
+        outputs = []
+        for start, end in zip(boundaries[:-1], boundaries[1:], strict=True):
+            q, k, v = (x[start:end].transpose(0, 1).unsqueeze(0) for x in (query, key, value))
+            outputs.append(self._attend(q, k, v).squeeze(0).transpose(0, 1))
+        return torch.cat(outputs).contiguous()
+
+
+class OuroTransformerLayer(TransformerLayer):
+    """Sandwich norms normalize each branch before its residual addition."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.post_self_attn_layernorm = OuroRMSNorm(self.config, self.config.hidden_size,
+                                                  self.config.layernorm_epsilon)
+        self.post_mlp_layernorm = OuroRMSNorm(self.config, self.config.hidden_size,
+                                            self.config.layernorm_epsilon)
+
+    def _apply_self_attn_bda_step(self, attention_output_with_bias, residual, *args, **kwargs):
+        value, bias = attention_output_with_bias
+        if bias is not None:
+            raise ValueError("Ouro attention output must be bias-free")
+        return super()._apply_self_attn_bda_step(
+            (self.post_self_attn_layernorm(value), None), residual, *args, **kwargs)
+
+    def _apply_mlp_bda_step(self, mlp_output_with_bias, residual, *args, **kwargs):
+        value, bias = mlp_output_with_bias
+        if bias is not None:
+            raise ValueError("Ouro MLP output must be bias-free")
+        return super()._apply_mlp_bda_step(
+            (self.post_mlp_layernorm(value), None), residual, *args, **kwargs)
+
+
+def ouro_block_spec(config):
+    layer = get_gpt_layer_local_spec(normalization="RMSNorm")
+    layer.module = OuroTransformerLayer
+    layer.submodules.input_layernorm = OuroRMSNorm
+    layer.submodules.pre_mlp_layernorm = OuroRMSNorm
+    layer.submodules.self_attention.submodules.core_attention = OuroSDPAttention
+    return TransformerBlockSubmodules(layer_specs=[layer] * config.num_layers, layer_norm=OuroRMSNorm)
+
+
+class OuroGPTModel(GPTModel):
+    def __init__(self, *, total_ut_steps=4, learned_depth=False, **kwargs):
+        config = kwargs["config"]
+        for name in ("tensor_model_parallel_size", "pipeline_model_parallel_size", "context_parallel_size"):
+            if getattr(config, name) != 1:
+                raise ValueError(f"Ouro initial native implementation requires {name}=1")
+        if not kwargs.get("pre_process", True) or not kwargs.get("post_process", True):
+            raise ValueError("Ouro needs the full shared decoder on each data-parallel rank")
+        if config.mtp_num_layers or config.sequence_parallel or config.num_moe_experts:
+            raise ValueError("Ouro does not support MTP, sequence parallelism, or MoE")
+        if type(total_ut_steps) is not int or total_ut_steps not in range(1, 5):
+            raise ValueError("Ouro loop count must be an integer in [1, 4]")
+        super().__init__(**kwargs)
+        self.total_ut_steps = total_ut_steps
+        # Preserve the pretrained gate in checkpoints/sync. Sequence-depth RL
+        # uses a separate policy; the native token gate is not optimized here.
+        self.early_exit_gate = nn.Linear(config.hidden_size, 1, dtype=config.params_dtype)
+        self.early_exit_gate.requires_grad_(False)
+        for parameter in self.early_exit_gate.parameters():
+            parameter.tensor_model_parallel = False
+        self.learned_depth = learned_depth
+        if learned_depth:
+            self.sequence_depth_head = nn.Linear(config.hidden_size, 3, dtype=config.params_dtype)
+            with torch.no_grad():
+                self.sequence_depth_head.weight.zero_()
+                self.sequence_depth_head.bias.copy_(torch.tensor([.1, .1, .8]).log())
+            for parameter in self.sequence_depth_head.parameters():
+                parameter.tensor_model_parallel = False
+                parameter.ouro_depth_parameter = True
+
+    def forward(self, input_ids, position_ids=None, attention_mask=None, decoder_input=None,
+                labels=None, inference_context=None, packed_seq_params=None,
+                extra_block_kwargs=None, runtime_gather_output=None, *, inference_params=None,
+                loss_mask=None, padding_mask=None, ouro_depth=None, ouro_prompt_length=None,
+                ouro_return_prompt_feature=False, **kwargs):
+        if inference_context is not None or inference_params is not None:
+            raise ValueError("Ouro native trainer does not use Megatron's inference cache")
+        if kwargs:
+            raise ValueError(f"Unsupported Ouro forward options: {sorted(kwargs)}")
+        depth = self.total_ut_steps if ouro_depth is None else ouro_depth
+        if isinstance(depth, bool) or not isinstance(depth, int) or depth not in range(1, 5):
+            raise ValueError("Each Ouro microbatch requires one integer depth in [1, 4]")
+        prep = self._preprocess(input_ids, position_ids, decoder_input=decoder_input,
+            packed_seq_params=packed_seq_params, padding_mask=padding_mask)
+        hidden, rope, cos, sin, offset, decoder_mask = prep[:6]
+        initial_hidden = hidden
+        for _ in range(depth):
+            # TransformerBlock applies the SAME final RMSNorm on every pass.
+            hidden = self.decoder(hidden_states=hidden, attention_mask=attention_mask,
+                rotary_pos_emb=rope, rotary_pos_cos=cos, rotary_pos_sin=sin,
+                packed_seq_params=packed_seq_params, sequence_len_offset=offset,
+                padding_mask=decoder_mask, **(extra_block_kwargs or {}))
+        if ouro_return_prompt_feature:
+            return hidden[-1, 0]
+        output = self._postprocess(hidden_states=hidden, input_ids=input_ids,
+            position_ids=position_ids, labels=labels, rotary_pos_emb=rope,
+            rotary_pos_cos=cos, rotary_pos_sin=sin, mtp_in_postprocess=False,
+            loss_mask=loss_mask, decoder_input=initial_hidden, attention_mask=attention_mask,
+            padding_mask=padding_mask, packed_seq_params=packed_seq_params,
+            sequence_len_offset=offset, runtime_gather_output=runtime_gather_output)
+        if self.learned_depth and ouro_prompt_length is not None:
+            if type(ouro_prompt_length) is not int or not 0 < ouro_prompt_length <= input_ids.shape[-1]:
+                raise ValueError("Learned depth requires a valid single-trajectory prompt boundary")
+            feature = self.forward(input_ids[:, :ouro_prompt_length], ouro_depth=4,
+                                   ouro_return_prompt_feature=True)
+            output.ouro_depth_log_probs = self.sequence_depth_head(feature).log_softmax(-1)
+        return output
+
+
+def get_ouro_model_provider(args, config, vp_stage=None):
+    hf = load_hf_config(args.hf_checkpoint, trust_remote_code=True)
+    if hf.model_type != "ouro" or config.num_layers != hf.num_hidden_layers:
+        raise ValueError("Ouro requires its original physical layer count and checkpoint config")
+    if vp_stage is not None or getattr(args, "virtual_pipeline_model_parallel_size", None):
+        raise ValueError("Ouro does not support virtual pipeline stages")
+    if (config.normalization != "RMSNorm" or config.add_bias_linear or not config.gated_linear_unit
+            or config.layernorm_zero_centered_gamma or config.qk_layernorm):
+        raise ValueError("Ouro requires plain RMSNorm, bias-free SwiGLU, and no QK norm")
+
+    def model_provider(pre_process=True, post_process=True, vp_stage=None):
+        if vp_stage is not None:
+            raise ValueError("Ouro does not support virtual pipeline stages")
+        return OuroGPTModel(config=config, transformer_layer_spec=ouro_block_spec(config),
+            vocab_size=args.padded_vocab_size, max_sequence_length=args.max_position_embeddings,
+            pre_process=pre_process, post_process=post_process, parallel_output=True,
+            share_embeddings_and_output_weights=hf.tie_word_embeddings,
+            position_embedding_type="rope", rotary_base=hf.rope_theta,
+            total_ut_steps=getattr(args, "ouro_depth", None) or hf.total_ut_steps,
+            learned_depth=getattr(args, "ouro_learned_depth", False))
+
+    return model_provider
