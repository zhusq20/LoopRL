@@ -0,0 +1,98 @@
+"""Functional replay of the *executed* token-exit trajectory (joint score).
+
+Only readouts/hazards through the recorded exit enter the objective. This lets
+all queries at a loop share last-exited K/V: the diagonal differs only for
+already exited queries, whose counterfactual readouts are deliberately unused.
+K/V crossing recurrent loops remain differentiable checkpoint outputs.
+"""
+from functools import partial
+
+import torch
+from torch.nn import functional as F
+from torch.utils.checkpoint import checkpoint
+from megatron.core.models.common.embeddings.rope_utils import apply_rotary_pos_emb
+
+
+def exit_layout(tokens, total_lengths, response_lengths, traces):
+    if not (len(total_lengths) == len(response_lengths) == len(traces)):
+        raise ValueError("Mismatched token-exit batch metadata")
+    readout = torch.full((tokens.shape[-1],), 4, device=tokens.device, dtype=torch.long)
+    cache = readout.clone()
+    offset = 0
+    for total, response, trace in zip(total_lengths, response_lengths, traces, strict=True):
+        prompt = total - response
+        if prompt < 1 or response < 1 or len(trace) != response or any(type(e) is not int or e not in (1, 2, 3, 4) for e in trace):
+            raise ValueError("Invalid per-token exit trace")
+        if offset + total > tokens.shape[-1]:
+            raise ValueError("Token-exit trace exceeds packed tokens")
+        values = torch.tensor(trace, device=tokens.device, dtype=torch.long)
+        readout[offset + prompt - 1:offset + total - 1] = values
+        # The first prediction reads the last prompt position. All prompt KV
+        # is dense, including that position, regardless of its selected readout.
+        cache[offset + prompt:offset + total - 1] = values[1:]
+        offset += total
+    return readout, cache
+
+
+def recurrent_layer(layer, hidden, previous_k, previous_v, *, loop, cache_exits, rope, packed):
+    attn = layer.self_attention
+    query, key, value = attn.get_query_key_value_tensors(layer.input_layernorm(hidden))
+    if packed is not None:
+        query, key, value = (x.squeeze(1) for x in (query, key, value))
+    kwargs = dict(config=layer.config, cu_seqlens=packed.cu_seqlens_q if packed is not None else None)
+    if packed is not None:
+        kwargs["max_seqlen"] = packed.max_seqlen_q
+    query = apply_rotary_pos_emb(query, rope, **kwargs)
+    key = apply_rotary_pos_emb(key, rope, **kwargs)
+    if previous_k is not None:
+        active = (cache_exits >= loop).reshape((-1,) + (1,) * (key.ndim - 1))
+        key = torch.where(active, key, previous_k)
+        value = torch.where(active, value, previous_v)
+    context = attn.core_attention(query, key, value, packed_seq_params=packed)
+    if packed is not None:
+        context = context.reshape(hidden.shape[0], 1, -1)
+    branch, bias = attn.linear_proj(context)
+    if bias is not None:
+        raise ValueError("Ouro token-exit attention must be bias-free")
+    hidden = hidden + layer.post_self_attn_layernorm(branch)
+    branch, bias = layer.mlp(layer.pre_mlp_layernorm(hidden))
+    if bias is not None:
+        raise ValueError("Ouro token-exit MLP must be bias-free")
+    return hidden + layer.post_mlp_layernorm(branch), key, value
+
+
+def forward(model, input_ids, packed_seq_params, total_lengths, response_lengths, traces):
+    if input_ids.shape[0] != 1 or model.config.context_parallel_size != 1:
+        raise ValueError("Token-exit replay requires packed batch=1 and CP=1")
+    readout, cache_exits = exit_layout(input_ids, total_lengths, response_lengths, traces)
+    prep = model._preprocess(input_ids, None, packed_seq_params=packed_seq_params)
+    hidden, rope = prep[:2]
+    initial = hidden
+    selected = torch.zeros_like(hidden)
+    logq = torch.zeros(input_ids.shape[-1], device=hidden.device, dtype=torch.float32)
+    states = [(None, None)] * len(model.decoder.layers)
+    use_checkpoint = torch.is_grad_enabled() and model.config.recompute_granularity == "full"
+    for loop in range(1, 5):
+        for index, layer in enumerate(model.decoder.layers):
+            function = partial(recurrent_layer, layer, loop=loop, cache_exits=cache_exits,
+                               rope=rope, packed=packed_seq_params)
+            if use_checkpoint:
+                hidden, key, value = checkpoint(function, hidden, *states[index],
+                                                use_reentrant=False, preserve_rng_state=False)
+            else:
+                hidden, key, value = function(hidden, *states[index])
+            states[index] = key, value
+        hidden = model.decoder.final_layernorm(hidden)
+        selected = torch.where((readout == loop)[:, None, None], hidden, selected)
+        if loop < 4:
+            hazard = model.early_exit_gate(hidden).squeeze(-1).squeeze(-1).float() - model.gate_shift
+            logq = logq + torch.where(readout == loop, F.logsigmoid(hazard),
+                                     torch.where(readout > loop, F.logsigmoid(-hazard), 0.))
+    output = model._postprocess(hidden_states=selected, input_ids=input_ids,
+        position_ids=None, labels=None, rotary_pos_emb=rope, rotary_pos_cos=None,
+        rotary_pos_sin=None, mtp_in_postprocess=False,
+        decoder_input=initial, attention_mask=None, packed_seq_params=packed_seq_params)
+    # Float16Module preserves an already-FP32 Tensor and its attached score.
+    output = output.float()
+    output.ouro_exit_log_probs = logq
+    return output
