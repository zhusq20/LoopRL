@@ -0,0 +1,20 @@
+"""Export Ouro's shared parameters without expanding recurrent iterations."""
+
+import re
+
+from ..hf_to_megatron.common import strip_mcore_wrappers
+from .llama import convert_llama_to_hf
+
+
+def convert_ouro_to_hf(args, name, param):
+    name = strip_mcore_wrappers(name)
+    if name in {"early_exit_gate.weight", "early_exit_gate.bias",
+                "sequence_depth_head.weight", "sequence_depth_head.bias"}:
+        return [(f"model.{name}", param)]
+    match = re.fullmatch(r"decoder\.layers\.(\d+)\.(post_self_attn_layernorm|post_mlp_layernorm)\.weight", name)
+    if match:
+        layer, norm = match.groups()
+        norm = "input_layernorm_2" if norm == "post_self_attn_layernorm" else "post_attention_layernorm_2"
+        return [(f"model.layers.{layer}.{norm}.weight", param)]
+    name = name.replace(".input_layernorm.weight", ".self_attention.linear_qkv.layer_norm_weight")
+    return convert_llama_to_hf(args, f"module.module.{name}", param)
